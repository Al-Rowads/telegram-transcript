TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# OpenAI transcription model. Keep whisper-1 for the v1 default.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Optional comma-separated allowlist, for example: 123456789,987654321
ALLOWED_TELEGRAM_USER_IDS=

# Cost and upload safety limits.
MAX_VIDEO_MB=100
MAX_OPENAI_AUDIO_MB=24
MAX_CONCURRENT_JOBS=1
