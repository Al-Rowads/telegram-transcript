# Telegram credentials. All three are required.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Required for Persian translation and optional Gemini/refinement passes.
OPENROUTER_API_KEY=
OPENROUTER_TRANSCRIPTION_REFINEMENT_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_REFINE_MODEL=google/gemini-2.5-flash-lite

# Deepgram is the default. Its key is required unless another provider is explicitly selected.
DEEPGRAM_API_KEY=
DEEPGRAM_TRANSCRIBE_MODEL=nova-3
DEEPGRAM_LANGUAGE=ar-IQ
DEEPGRAM_KEYTERMS=
# Optional direct Whisper transcription (selected manually).
OPENAI_API_KEY=

# Persian translation is enabled for new scopes by default.
REFINE=true

# Leave blank to allow all Telegram users.
ALLOWED_TELEGRAM_USER_IDS=

MAX_VIDEO_MB=2048
AUDIO_TEMPO=1.0
MAX_CONCURRENT_JOBS=1

# Outbound Telegram Bot API timeouts. Media uploads use the longer write timeout.
TELEGRAM_REQUEST_TIMEOUT_SECONDS=30
TELEGRAM_MEDIA_WRITE_TIMEOUT_SECONDS=120

# Per-user/per-group preferences only. No per-media metadata is persisted.
SCOPED_STATE_PATH=data/bot-state.sqlite3

# Legacy state inputs only; the configured video registry is purged automatically at startup.
RUNTIME_STATE_PATH=data/runtime-settings.json
VIDEO_REGISTRY_PATH=data/videos.sqlite3
