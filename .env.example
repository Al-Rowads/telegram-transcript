# Telegram bot token from BotFather. Required.
TELEGRAM_BOT_TOKEN=

# Telegram API credentials from https://my.telegram.org. Required for Telethon
# media downloads, which allow bot media up to Telegram's 2 GiB file limit.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Deepgram is required for transcription.
# Deepgram can return timestamps, so the bot can send transcript.srt.
DEEPGRAM_API_KEY=
DEEPGRAM_TRANSCRIBE_MODEL=nova-3
DEEPGRAM_LANGUAGE=ar-IQ
DEEPGRAM_KEYTERMS=

# Direct OpenAI is required as the final timestamp-capable transcription fallback.
OPENAI_API_KEY=

# OpenRouter is required for the Gemini and Whisper Large V3 transcription
# models, Iraqi Arabic transcription refinement, and Persian translation.
OPENROUTER_API_KEY=

# OpenRouter model used to refine validated SRT into natural Iraqi Baghdadi Arabic.
# This stage always runs when speech and timestamps are available.
OPENROUTER_TRANSCRIPTION_REFINEMENT_MODEL=openai/gpt-5.5

# Persistent directory for pinned Iraqi Arabic reference datasets used only by
# Gemini transcription refinement. Missing or invalid files download at startup.
IRAQI_TRAINING_RESOURCES_PATH=data/iraqi-training-resources

# OpenRouter model used only to add Persian translations to refined SRT subtitles.
OPENROUTER_REFINE_MODEL=openai/gpt-5.5

# Set to true to send transcript.srt with green Persian translations under each Arabic cue.
# The plain line-by-line translation is derived locally from that translated SRT.
REFINE=false

# Optional comma-separated Telegram user ID allowlist.
# Leave blank to allow all users.
# Example: 123456789,987654321
ALLOWED_TELEGRAM_USER_IDS=

# Cost and upload safety limits, in megabytes.
# Telethon can download bot media up to Telegram's 2048 MB file limit.
MAX_VIDEO_MB=2048

# Audio tempo for the generated lossless FLAC. 1.0 keeps normal speed.
# Valid range: 0.5 to 2.0.
AUDIO_TEMPO=1.0

# Number of videos processed at the same time.
MAX_CONCURRENT_JOBS=1

# Durable bot-wide command settings (/tempo, /model, /refiner, /tmodel, /translation).
RUNTIME_STATE_PATH=data/runtime-settings.json
