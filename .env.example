# Telegram credentials. All three are required.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Required for the default Gemini transcription path, Iraqi cleaning, and Persian translation.
OPENROUTER_API_KEY=
OPENROUTER_TRANSCRIPTION_REFINEMENT_MODEL=openai/gpt-5.5
OPENROUTER_REFINE_MODEL=openai/gpt-5.5

# Optional timestamp-capable transcription providers.
DEEPGRAM_API_KEY=
DEEPGRAM_TRANSCRIBE_MODEL=nova-3
DEEPGRAM_LANGUAGE=ar-IQ
DEEPGRAM_KEYTERMS=
OPENAI_API_KEY=

# Persian translation is enabled for new scopes by default.
REFINE=true

# Leave blank to allow all Telegram users.
ALLOWED_TELEGRAM_USER_IDS=

MAX_VIDEO_MB=2048
AUDIO_TEMPO=1.0
MAX_CONCURRENT_JOBS=1

# Per-user/per-group preferences and seven-day content-free job metadata.
SCOPED_STATE_PATH=data/bot-state.sqlite3

# Legacy migration inputs only; new code does not write these stores.
RUNTIME_STATE_PATH=data/runtime-settings.json
VIDEO_REGISTRY_PATH=data/videos.sqlite3
