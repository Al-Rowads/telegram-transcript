TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# OpenAI transcription model.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# OpenAI text model used to refine raw ASR output into Baghdadi Iraqi Arabic.
OPENAI_REFINE_MODEL=gpt-5.4-mini

# Optional comma-separated allowlist, for example: 123456789,987654321
ALLOWED_TELEGRAM_USER_IDS=

# Cost and upload safety limits.
MAX_VIDEO_MB=100
MAX_OPENAI_AUDIO_MB=24

# Audio tempo for the generated MP3. 0.90 slows fast speakers while preserving pitch.
AUDIO_TEMPO=0.90

MAX_CONCURRENT_JOBS=1
