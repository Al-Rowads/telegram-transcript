TELEGRAM_BOT_TOKEN=

# Speech-to-text provider. Supported values: deepgram, openai.
SPEECH_TO_TEXT_PROVIDER=deepgram

# Deepgram Nova-3 Arabic transcription.
DEEPGRAM_API_KEY=
DEEPGRAM_TRANSCRIBE_MODEL=nova-3
DEEPGRAM_LANGUAGE=ar

# OpenAI is required when SPEECH_TO_TEXT_PROVIDER=openai or REFINE=true.
OPENAI_API_KEY=

# OpenAI transcription model, used only when SPEECH_TO_TEXT_PROVIDER=openai.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# OpenAI text model used to refine raw ASR output into Baghdadi Iraqi Arabic.
OPENAI_REFINE_MODEL=gpt-5.4-mini

# Set to true to run the OpenAI refinement step after transcription.
REFINE=false

# Optional comma-separated allowlist, for example: 123456789,987654321
ALLOWED_TELEGRAM_USER_IDS=

# Cost and upload safety limits.
MAX_VIDEO_MB=100
MAX_AUDIO_MB=24

# Audio tempo for the generated MP3. 1.0 keeps normal speed.
AUDIO_TEMPO=1.0

MAX_CONCURRENT_JOBS=1
